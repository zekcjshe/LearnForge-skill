{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video2obsidian/anchor_audit/v1",
  "title": "Video2Obsidian Teaching Anchor Audit",
  "type": "object",
  "required": [
    "generated_at",
    "video_id",
    "source_title",
    "candidates",
    "final_anchors"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "source_title": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quote", "timestamp", "up_name", "kept", "kind"],
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "timestamp": {
            "type": "string",
            "pattern": "^[0-9]{1,3}:[0-9]{2}(?::[0-9]{2})?-[0-9]{1,3}:[0-9]{2}(?::[0-9]{2})?$"
          },
          "up_name": {
            "type": "string",
            "minLength": 1
          },
          "kept": {
            "type": "boolean"
          },
          "reason": {
            "type": "object",
            "required": ["irreplaceable", "non_derivable", "memorable"],
            "properties": {
              "irreplaceable": {"type": "string", "minLength": 1},
              "non_derivable": {"type": "string", "minLength": 1},
              "memorable": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "reason_failed": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": ["insight", "warning", "analogy", "attitude", "punchline"]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"kept": {"const": true}}},
            "then": {"required": ["reason", "rank"]}
          },
          {
            "if": {"properties": {"kept": {"const": false}}},
            "then": {"required": ["reason_failed"]}
          }
        ],
        "additionalProperties": false
      }
    },
    "final_anchors": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "final_selection_reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
